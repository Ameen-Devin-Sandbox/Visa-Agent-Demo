{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Categorizer",
  "description": "Schema for dispute categorization rules from Sections 11.6-11.10",
  "type": "object",
  "required": ["version", "source_section", "fraud_indicators", "authorization_indicators", "processing_error_indicators", "categories"],
  "properties": {
    "version": { "type": "string" },
    "source_section": { "type": "string" },
    "fraud_indicators": {
      "type": "array",
      "items": { "type": "string" }
    },
    "authorization_indicators": {
      "type": "array",
      "items": { "type": "string" }
    },
    "processing_error_indicators": {
      "type": "array",
      "items": { "type": "string" }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description", "conditions"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "conditions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
